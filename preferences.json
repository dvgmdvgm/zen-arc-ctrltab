[
  {
    "type": "checkbox",
    "property": "zen-arc-ctrltab.enabled",
    "label": "Ctrl+Tab shows a visual tab switcher (most recently used first)",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Behaviour",
    "margin": "15px 0 15px 0"
  },
  {
    "type": "dropdown",
    "property": "zen-arc-ctrltab.open-mode",
    "value": "number",
    "label": "How the panel works",
    "defaultValue": 0,
    "options": [
      { "label": "Hold Ctrl, press Tab to move, release Ctrl to switch", "value": 0 },
      { "label": "Press Ctrl+Tab once: the panel stays open (Enter or click to switch, Esc to cancel)", "value": 1 }
    ]
  },
  {
    "type": "dropdown",
    "property": "zen-arc-ctrltab.repeat-speed",
    "value": "number",
    "label": "Holding Tab moves the highlight at most",
    "defaultValue": 8,
    "options": [
      { "label": "4 tabs per second", "value": 4 },
      { "label": "6 tabs per second", "value": 6 },
      { "label": "8 tabs per second", "value": 8 },
      { "label": "12 tabs per second", "value": 12 },
      { "label": "As fast as the keyboard repeats", "value": 0 }
    ]
  },
  {
    "type": "dropdown",
    "property": "zen-arc-ctrltab.open-delay",
    "value": "number",
    "label": "Wait before the panel appears (a quick Ctrl+Tab tap flips to the previous tab without showing it)",
    "defaultValue": 200,
    "options": [
      { "label": "None: appears at once", "value": 0 },
      { "label": "100 ms", "value": 100 },
      { "label": "200 ms (Firefox default)", "value": 200 },
      { "label": "300 ms", "value": 300 },
      { "label": "500 ms", "value": 500 }
    ]
  },
  {
    "type": "checkbox",
    "property": "zen-arc-ctrltab.show-unloaded",
    "label": "Include unloaded tabs (shown muted)",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "zen-arc-ctrltab.hide-unloaded-pinned",
    "label": "Leave out unloaded pinned tabs (pinned tabs show up only while loaded)",
    "defaultValue": false
  },
  {
    "type": "dropdown",
    "property": "zen-arc-ctrltab.max-tabs",
    "value": "number",
    "label": "Most tabs shown in the panel",
    "defaultValue": 10,
    "options": [
      { "label": "6", "value": 6 },
      { "label": "8", "value": 8 },
      { "label": "10", "value": 10 },
      { "label": "12", "value": 12 },
      { "label": "16", "value": 16 },
      { "label": "24", "value": 24 },
      { "label": "36", "value": 36 }
    ]
  },
  {
    "type": "separator",
    "label": "Layout",
    "margin": "15px 0 15px 0"
  },
  {
    "type": "dropdown",
    "property": "zen-arc-ctrltab.layout",
    "value": "number",
    "label": "Panel layout",
    "defaultValue": 0,
    "options": [
      { "label": "Previews: a grid of thumbnails", "value": 0 },
      { "label": "List: tabs top to bottom, no previews", "value": 1 },
      { "label": "List and preview: tab list on the left, large preview on the right", "value": 2 }
    ]
  },
  {
    "type": "checkbox",
    "property": "zen-arc-ctrltab.compact",
    "label": "Compact: the panel window is only as big as the panel, centred in the browser window (otherwise it covers the whole window)",
    "defaultValue": false
  },
  {
    "type": "dropdown",
    "property": "zen-arc-ctrltab.size",
    "value": "number",
    "label": "Panel size: scales the panel, previews, icons and text together",
    "defaultValue": 100,
    "options": [
      { "label": "70%", "value": 70 },
      { "label": "85%", "value": 85 },
      { "label": "100%", "value": 100 },
      { "label": "115%", "value": 115 },
      { "label": "130%", "value": 130 },
      { "label": "150%", "value": 150 },
      { "label": "175%", "value": 175 },
      { "label": "200%", "value": 200 },
      { "label": "250%", "value": 250 }
    ]
  },
  {
    "type": "dropdown",
    "property": "zen-arc-ctrltab.tiles-per-row",
    "value": "number",
    "label": "Previews per row (grid layout; fewer means bigger)",
    "defaultValue": 5,
    "options": [
      { "label": "3", "value": 3 },
      { "label": "4", "value": 4 },
      { "label": "5", "value": 5 },
      { "label": "6", "value": 6 },
      { "label": "7", "value": 7 }
    ]
  },
  {
    "type": "checkbox",
    "property": "zen-arc-ctrltab.show-all-button",
    "label": "Show the \"List all tabs\" button under the panel",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Colors",
    "margin": "15px 0 15px 0"
  },
  {
    "type": "string",
    "property": "zen-arc-ctrltab.accent",
    "label": "Highlight color (any CSS color; empty uses your theme's accent)",
    "placeholder": "#5b6cf0",
    "defaultValue": ""
  }
]
